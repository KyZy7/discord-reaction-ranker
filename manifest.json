{
  "manifest_version": 3,
  "name": "Discord Reaction Ranker",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "description": "Rank forum opening posts by reactions observed while you browse Discord.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["core-main.js", "observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://discord.com/*"],
      "js": ["core.js", "forum-names.js", "panel.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
